# Network & Chain Configuration (Robinhood Chain ID: 4663)
RH_CHAIN_ID=4663
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional Third-Party RPC Fallbacks (Free Tier: Alchemy, QuickNode, etc.)
ALCHEMY_RPC_URL=
QUICKNODE_RPC_URL=

# Wallet Configuration
# Input your private key (0x...) to execute transactions on-chain.
# Leave blank for Read-Only mode.
PRIVATE_KEY=
WALLET_ADDRESS=

# Data Directory (JSON Storage)
DATA_DIR=./data

# Execution & Safety Settings
# DRY_RUN=true will simulate transactions with eth_call without sending on-chain.
# Set DRY_RUN=false to execute real live transactions.
DRY_RUN=false
EXECUTION_ENABLED=true
MAX_GAS_COST_USD=2.00
DEFAULT_SLIPPAGE_BPS=100

# Telegram Bot Configuration
# Obtain your TELEGRAM_BOT_TOKEN from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated list of authorized chat IDs or user IDs (e.g. 123456789,987654321)
TELEGRAM_ALLOWED_CHATS=

